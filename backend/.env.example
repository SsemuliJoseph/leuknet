# Copy to .env for local development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Public URL of the FRONTEND - used to build the link inside each report's QR code
FRONTEND_URL=http://localhost:5173
# SQLite locally. For persistent free hosting use a Postgres URL (Neon / Supabase)
DATABASE_URL=sqlite:///./leuknet.db

MODEL_CONFIG_PATH=model/config.json
MODEL_WEIGHTS_PATH=model/model.weights.h5
MODEL_METADATA_PATH=model/metadata.json

# --- Calibrate these with scripts/calibrate.py (see README) ---
# resnet  = keras.applications.resnet50.preprocess_input (RGB->BGR, mean subtraction)
# rescale = pixel / 255.0
# none    = raw 0-255 pixels
PREPROCESS_MODE=resnet
# Class names in the model's output order (index 0, index 1)
CLASS_NAMES=blast,non_blast
# Which output index means "blast / leukemic"
BLAST_CLASS_INDEX=0

# 0 = same as the model input size (non-overlapping tiles). Smaller values overlap tiles and may double-count cells.
TILE_STRIDE=0
MAX_IMAGE_SIDE=1536
BLAST_PROB_THRESHOLD=0.5
MAX_FILES_PER_REQUEST=8
MAX_UPLOAD_MB=15

# --- Accounts (REQUIRED for production) ---
# A long random string, e.g.  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production
# This account is created automatically on startup (more: python scripts/create_user.py EMAIL PASSWORD)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password

# --- Optional: Mistral AI plain-language result summaries (falls back to a built-in template) ---
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# --- Report rules / checks ---
# More than this many suspected blast regions -> "acute lymphoblastic leukemia is indicated", otherwise "chronic".
# This is the rule stated in the LeukNet report. Set to 0 to switch the rule off. Not a validated clinical criterion.
ACUTE_BLAST_THRESHOLD=15
MAX_PDF_PAGES=4
# "Unknown" checks (set BLUR_THRESHOLD=0 / MIN_STAIN_FRACTION=0 to disable)
BLUR_THRESHOLD=8
MIN_STAIN_FRACTION=0.02
FOREIGN_OBJECT_CHECK=true
# QR verification page: true = patient name, age, gender, result; false = initials only
VERIFY_SHOW_FULL_DETAILS=true
